APP_NAME="Hagamra"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hagamra
DB_USERNAME=hagamra
DB_PASSWORD=

# Separate schema used by the automated test suite. It is wiped on every run.
DB_TEST_DATABASE=hagamra_test

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Hagamra -----------------------------------------------------------------

# Comma separated origins allowed to call the API (the two Next.js apps).
FRONTEND_ADMIN_URL=http://localhost:3000
FRONTEND_COMPANY_URL=http://localhost:3001

# Credentials created by database/seeders/SuperAdminSeeder.php on a fresh install.
# Change the password immediately after the first login.
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@hagamra.test
SUPER_ADMIN_PASSWORD=

# Access tokens issued to MCP clients expire after this many minutes (null = never).
# Global, applies to every token including the MCP agent's. Leave blank.
SANCTUM_TOKEN_EXPIRATION=
# Minutes a browser sign-in stays valid. Keep in step with
# SESSION_LIFETIME_MINUTES in the two panels.
SESSION_TOKEN_EXPIRATION=480
