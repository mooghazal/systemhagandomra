# Where the Laravel backend lives.
#
# This is read on the SERVER only (no NEXT_PUBLIC_ prefix): the browser never
# talks to Laravel directly. It calls this app's own /api/laravel proxy, which
# attaches the access token from an httpOnly cookie. Keeping the backend URL
# server-side means the API's address is not published in the JS bundle.
API_URL=http://127.0.0.1:8000/api

# Set to 1 in production so the session cookie is only sent over HTTPS.
# Leave unset for local http development, or the cookie is never stored.
COOKIE_SECURE=

# How long a session lasts before the panel asks for a login again, in minutes.
SESSION_LIFETIME_MINUTES=480

# Two apps on localhost share a cookie jar (browsers ignore the port),
# so each names its own session cookie.
SESSION_COOKIE_NAME=hagamra_company
